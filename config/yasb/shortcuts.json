    {"title":"Focus and Windows","items":[
      {"keys":["Caps","Left"],"description":"Focus left"},
      {"keys":["Caps","J / Down"],"description":"Focus down"},
      {"keys":["Caps","K / Up"],"description":"Focus up"},
      {"keys":["Caps","L / Right"],"description":"Focus right"},
      {"keys":["Caps","Space"],"description":"Cycle focus"},
