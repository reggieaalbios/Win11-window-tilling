    {"title":"Apps and Dropdowns","items":[
      {"keys":["Caps","E"],"description":"Open File Explorer"},
      {"keys":["Caps","B"],"description":"Open browser"},
      {"keys":["Caps","Shift","E"],"description":"Toggle dropdown Explorer"},
      {"keys":["Caps","Shift","R"],"description":"Toggle dropdown Notes"}
    ]},
    {"title":"Layouts","items":[
      {"keys":["Caps","T"],"description":"Next layout"},
      {"keys":["Caps","V"],"description":"Toggle floating"},
      {"keys":["Caps","Ctrl","F"],"description":"Toggle monocle"},
      {"keys":["Caps","Shift","W"],"description":"Retile workspace"},
      {"keys":["Caps","Shift","P"],"description":"Pause Komorebi"},
      {"keys":["Caps","Shift","F"],"description":"Toggle fullscreen"}
    ]},
    {"title":"Workspaces and Monitors","items":[
      {"keys":["Caps","1–5"],"description":"Focus workspace"},
