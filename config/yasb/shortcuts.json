    {"title":"Move and Resize","items":[
      {"keys":["{{MAIN_MODIFIER_LABEL}}","Left drag"],"description":"Move or rearrange a managed window"},
      {"keys":["Caps","Alt","H / J / K / L"],"description":"Move window"},
      {"keys":["Caps","Shift","H / J / K / L"],"description":"Resize window"},
      {"keys":["Caps","U / P"],"description":"Decrease or increase width"},
      {"keys":["Caps","I / O"],"description":"Decrease or increase height"},
      {"keys":["Caps","R"],"description":"Enter resize mode"}
